{
  "name": "@cluestick-io/dipstick",
  "version": "0.1.0",
  "description": "Daily App Store rating deltas — worldwide, per-country, per-star — posted to a GitHub issue or Slack.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dipstick": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "check": "node src/cli.ts check",
    "verify:storefronts": "node --test \"test/storefronts.live.ts\"",
    "prepare": "tsc"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "app-store",
    "ratings",
    "aso",
    "slack",
    "ios"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cluestick-io/dipstick.git"
  },
  "homepage": "https://github.com/cluestick-io/dipstick#readme",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3"
  }
}
